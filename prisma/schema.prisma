// ==============================================================================
// TRENDPDF STUDIO — PRISMA ORM SCHEMA
// ==============================================================================
// Para desenvolvimento local rápido (SQLite) e migração para PostgreSQL (Supabase/Neon).
//
// Como alternar para PostgreSQL:
// Troque provider = "sqlite" por provider = "postgresql"
// E no .env configure: DATABASE_URL="postgresql://user:password@host:5432/trendpdf"
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  passwordHash     String?      // Opcional para logins sociais
  name             String       @default("Criador de Conteúdo")
  avatarUrl        String?
  plan             String       @default("pro") // free, pro, enterprise
  aiCreditsBalance Int          @default(100)
  aiCreditsUsed    Int          @default(16)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  ideas            Idea[]
  settings         UserSettings?
  creditLogs       AiCreditLog[]

  @@map("users")
}

model Trend {
  id               String   @id
  keyword          String
  category         String
  monthlySearches  String
  growthRate       String
  competitionLevel String
  score            Float
  summary          String
  suggestedFormat  String
  suggestedTicket  String
  statusBadge      String
  provenance       String? // Dados de auditoria e proveniência JSON
  createdAt        DateTime @default(now())

  @@map("trends")
}

model Idea {
  id              String    @id
  userId          String
  title           String
  format          String
  suggestedPrice  String
  orderBump       String
  orderBumpPrice  String
  score           Float
  status          String    @default("Pronto para Produção")
  targetAudience  String
  coreProblem     String
  whySellNow      String
  saved           Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters        Chapter[]

  @@map("ideas")
}

model Chapter {
  id            String   @id @default(uuid())
  ideaId        String
  chapterNumber Int
  title         String
  description   String?
  createdAt     DateTime @default(now())

  idea          Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@unique([ideaId, chapterNumber])
  @@map("chapters")
}

model UserSettings {
  id                 String   @id @default(uuid())
  userId             String   @unique
  authorName         String   @default("Ana Martins")
  currentPlan        String   @default("Plano Pro")
  currency           String   @default("Real Brasileiro (R$)")
  defaultEbookPages  String   @default("Guia Prático Padrão (30 a 50 páginas)")
  geminiApiKey       String?
  themePreference    String   @default("system")
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model AiCreditLog {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  action    String
  details   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_credit_logs")
}

