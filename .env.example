# 1. INTEGRAÇÃO COM SUPABASE (POSTGRESQL & AUTH)
# Obtenha em: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-do-supabase

# 2. BANCO DE DADOS LOCAL (PRISMA / SQLITE OU POSTGRESQL)
# Para SQLite local (desenvolvimento imediato sem nuvem):
DATABASE_URL="file:./dev.db"
# Para PostgreSQL (em produção):
# DATABASE_URL="postgresql://postgres:sua-senha@db.seu-projeto.supabase.co:5432/postgres"

# 3. GOOGLE GEMINI API (Opcional - pode ser configurado também na interface do app)
VITE_GEMINI_API_KEY=

